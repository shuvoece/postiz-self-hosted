# Copy to .env and fill in:   cp .env.example .env
# Generate secrets with:      ./scripts/generate-secrets.sh
# NEVER commit the real .env file.

# --- Public URL (no trailing slash)
# Local test:   http://localhost:4007
# Production:   https://postiz.example.com
POSTIZ_URL=http://localhost:4007

# Host port and bind address
#   127.0.0.1 -> only reachable from this machine / reverse proxy (recommended)
#   0.0.0.0   -> reachable from the network
POSTIZ_BIND=127.0.0.1
POSTIZ_PORT=4007

# Pin a version for production, e.g. v2.x.y (see GitHub releases)
POSTIZ_VERSION=latest

# --- Secrets
JWT_SECRET=change-me
POSTGRES_USER=postiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postiz
TEMPORAL_DB_PASSWORD=change-me

# Set to true after creating your admin account
DISABLE_REGISTRATION=false

# --- Optional social providers (leave empty if unused)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
